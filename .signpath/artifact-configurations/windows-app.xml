<?xml version="1.0" encoding="utf-8"?>
<!-- Pass 1: the packaged app folder (release/win-unpacked, zipped by upload-artifact).
     Signs Artha.exe, whose ProductVersion electron-builder writes as e.g. 0.1.0.0.
     Paste into the SignPath project as artifact configuration "windows-app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Artha.exe" product-name="Artha" product-version="${version}.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
