{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "COSMOS_CONNECTION_STRING": "<from `az cosmosdb keys list --type connection-strings`>",
    "COSMOS_DATABASE": "artha",
    "JWT_SIGNING_KEY": "<random 32+ byte secret, e.g. `openssl rand -base64 32`>",
    "ACS_CONNECTION_STRING": "<from `az communication list-key --name <acs-name>`>",
    "ACS_SENDER_ADDRESS": "DoNotReply@<generated-guid>.azurecomm.net — see README's Email verification section",
    "ALLOWED_ORIGIN": "*"
  }
}
