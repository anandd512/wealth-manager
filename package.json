{
  "name": "artha",
  "version": "0.1.0",
  "description": "Local-first personal net worth and insurance tracker",
  "main": "./out/main/index.js",
  "author": "Anand Deshpande",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "artha": "powershell -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.55.0",
    "openai": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@44.9.1": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.local.artha",
    "productName": "Artha",
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "artifactName": "Artha-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "anandd512",
        "repo": "wealth-manager",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anandd512/wealth-manager.git"
  }
}
